# SwiftPM
.build/
.swiftpm/
Package.resolved
*.resolved

# Generated by `make xcode` from project.yml — never commit, never hand-edit.
OmniTag.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# Xcode build output and per-user state
DerivedData/
build/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Test and coverage output
*.xcresult/
*.profraw
*.profdata

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editors
.vscode/
.idea/
*.swp
*~

# Never commit media: fixtures are generated, real files stay outside the repo.
*.mp3
*.m4a
*.m4b
*.mp4
*.m4v
*.mov
*.mkv
*.flac
*.wav
*.aiff
*.ogg
*.opus

# Local secrets — API keys belong in the Keychain, never on disk here.
.env
*.local.plist
secrets.json
